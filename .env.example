# ==========================================
# Resolv.AI - Environment Template (.env.example)
# Copy this file to .env and configure your local settings
# ==========================================

# Google Gemini Credentials
GOOGLE_API_KEY=

# LangSmith Tracing (Optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT="testing"

# API Specifications
API_URL=http://127.0.0.1:8000
SECRET_KEY="SUPER_SECRET_KEY"
ALGORITHM="HS256"
LANGGRAPH_API=false

# Database & Vectors Network Configuration
# For macOS (Docker Desktop), set these to host.docker.internal
# For Windows/Linux, set these to localhost
DB_HOST=localhost
QDRANT_HOST=localhost

# Databases Connection URIs (Docker uses DB_HOST and QDRANT_HOST dynamically)
QDRANT_CLIENT_URL=http://${QDRANT_HOST}:6333
DB_URI="postgresql://postgres:pwd@${DB_HOST}:5432/langgraph"
DATABASE_URL="postgresql+psycopg2://postgres:pwd@${DB_HOST}:5432/postgres"
